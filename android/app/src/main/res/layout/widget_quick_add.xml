<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_sub3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_fuel"
            style="@style/WidgetBtn"
            android:text="@string/widget_fuel" />
        <TextView
            android:id="@+id/w_maint"
            style="@style/WidgetBtn"
            android:text="@string/widget_maint" />
        <TextView
            android:id="@+id/w_exp"
            style="@style/WidgetBtn"
            android:text="@string/widget_exp" />
        <TextView
            android:id="@+id/w_km"
            style="@style/WidgetBtn"
            android:text="@string/widget_km" />
    </LinearLayout>
</LinearLayout>
